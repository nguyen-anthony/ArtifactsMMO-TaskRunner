# Copy to `.env` (never commit it). Loaded by Docker Compose on the VPS.
PORT=8080

# Supabase → Project Settings → Database → Connection string → "Session pooler" (port 5432).
# Do NOT use the transaction pooler (6543): LISTEN/NOTIFY needs a persistent session.
DATABASE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USER=postgres.<project-ref>
DATABASE_PASSWORD=
DATABASE_SCHEMA=taskrunner

# ArtifactsMMO token (https://artifactsmmo.com/account)
ARTIFACTS_TOKEN=

# Game servers (defaults: production). For a beta test instance use
#   ARTIFACTS_API_URL=https://api.beta.artifactsmmo.com
#   ARTIFACTS_REALTIME_URL=wss://realtime.beta.artifactsmmo.com
# with its own PORT and its own database (the engine lock and NOTIFY channel are database-wide).
# ARTIFACTS_API_URL=https://api.artifactsmmo.com
# ARTIFACTS_REALTIME_URL=wss://realtime.artifactsmmo.com

# Static key you type into the web UI login. Generate with: openssl rand -base64 32
ADMIN_API_KEY=

# Session cookie is HTTPS-only by default. Set to false ONLY for local http://localhost testing.
COOKIE_SECURE=true

# Public hostname for Caddy (automatic HTTPS). Leave unset to serve plain HTTP on :80.
# SITE_ADDRESS=ammo.example.com
